# ==============================================================================
# FloodSafe Route — Environment Configuration Template
# Copy this file to .env and adjust variables as needed. NEVER commit .env to git!
# ==============================================================================

# Application & Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars-long

# Pilot District Settings (Kanpur Nagar default, configurable)
DISTRICT_NAME=Kanpur Nagar
DISTRICT_STATE=Uttar Pradesh
DISTRICT_COUNTRY=India
# Bounding Box: [min_lon, min_lat, max_lon, max_lat] in WGS84
DISTRICT_BBOX=80.15,26.35,80.45,26.55
# Target Coordinate Reference System (UTM 44N covers Kanpur)
TARGET_CRS=EPSG:32644

# Database Connection (PostgreSQL + PostGIS)
# Local Docker or Cloud Managed (Neon / Supabase)
DATABASE_URL=postgresql+psycopg://flooduser:floodpassword@localhost:5432/floodsafe_db
ASYNC_DATABASE_URL=postgresql+psycopg://flooduser:floodpassword@localhost:5432/floodsafe_db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
REPORT_RATE_LIMIT_PER_HOUR=10

# Routing & Risk Parameters
DEFAULT_SAFETY_ALPHA=3.0
MAX_SAFETY_ALPHA=10.0
CITIZEN_REPORT_EXPIRY_HOURS=3
CITIZEN_REPORT_RADIUS_METERS=50.0

# Optional External Data Services (Not required for local bundled data mode)
EARTH_ENGINE_PROJECT=
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_KEY_FILE=
